---
/**
 * Asset #17 — long arrow CTA glyph. Replaces the &#10230; entity, which
 * renders at wildly different widths and weights across platforms.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg
  class:list={['arrow', className]}
  viewBox="0 0 40 8"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  aria-hidden="true"
  focusable="false"
>
  <path d="M0 4h38" />
  <path d="M33 0.5 38.5 4 33 7.5" />
</svg>
