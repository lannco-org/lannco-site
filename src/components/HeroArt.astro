---
/**
 * Hero visual — drawn ink-wash mountain with the red silk ribbon.
 *
 * This is still a STAND-IN for docs/ASSETS.md #1 (the generated photographic
 * hero), which is why it carries `data-asset`. It replaces the flat grey
 * gradient that used to sit here: the composition, values and the red ribbon
 * are the ones Board A shows, so the page reads as art-directed while the real
 * image is outstanding. Vector, so it costs nothing and scales cleanly.
 *
 * Everything is one SVG with a `slice` aspect ratio, so it behaves like a
 * background image — it fills the hero column at any shape without distorting.
 */
interface Props {
  class?: string;
  parallax?: string;
}
const { class: className, parallax } = Astro.props;
---
<div
  class:list={['hero-art', className]}
  data-parallax={parallax}
  data-asset="#1 mountain in mist with red silk ribbon"
  role="img"
  aria-label="Ink-wash mountain in mist with a red silk ribbon across its base"
>
  <svg viewBox="0 0 1000 820" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="ha-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#f7f4ee" />
        <stop offset="60%" stop-color="#efeae1" />
        <stop offset="100%" stop-color="#e6e0d5" />
      </linearGradient>
      <linearGradient id="ha-peak" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#15140f" stop-opacity="0.94" />
        <stop offset="38%" stop-color="#2f2b25" stop-opacity="0.82" />
        <stop offset="72%" stop-color="#4d4841" stop-opacity="0.42" />
        <stop offset="100%" stop-color="#6b665c" stop-opacity="0.05" />
      </linearGradient>
      <linearGradient id="ha-far" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3a352e" stop-opacity="0.34" />
        <stop offset="70%" stop-color="#6f6a60" stop-opacity="0.12" />
        <stop offset="100%" stop-color="#6f6a60" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="ha-silk" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="#7e211a" />
        <stop offset="45%" stop-color="#a02a20" />
        <stop offset="100%" stop-color="#c04436" />
      </linearGradient>
      <linearGradient id="ha-haze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#f5f2ec" stop-opacity="0" />
        <stop offset="55%" stop-color="#f5f2ec" stop-opacity="0.72" />
        <stop offset="100%" stop-color="#f5f2ec" stop-opacity="1" />
      </linearGradient>

      <filter id="ha-soft" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="2.4" />
      </filter>
      <filter id="ha-softer" x="-25%" y="-25%" width="150%" height="150%">
        <feGaussianBlur stdDeviation="7" />
      </filter>
      <filter id="ha-mist" x="-40%" y="-60%" width="180%" height="220%">
        <feGaussianBlur stdDeviation="26" />
      </filter>
      <filter id="ha-glow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="16" />
      </filter>
    </defs>

    <rect width="1000" height="820" fill="url(#ha-sky)" />

    {/* Far ridges — broad, low contrast, heavily softened, so the eye reads
        depth before it reads shape. */}
    <g filter="url(#ha-softer)">
      <path
        d="M-60 820 L-20 690 L70 716 L190 560 L262 596 L360 496 L440 560 L520 820 Z"
        fill="url(#ha-far)"
      />
      <path
        d="M640 820 L742 636 L800 664 L892 512 L948 556 L1060 668 L1060 820 Z"
        fill="url(#ha-far)"
      />
    </g>

    {/* The signature peak: one broad asymmetric mass, shallow rock notches
        rather than needles, dark at the summit and dissolving into mist at the
        base — the sumi-e value structure from the boards. */}
    <g filter="url(#ha-soft)">
      <path
        d="M-60 820
           L40 706 L128 730 L236 574 L292 602 L370 452 L412 476 L474 286
           L506 314 L532 154
           L560 220 L598 196 L642 340 L676 316 L730 442 L772 418 L836 532
           L880 512 L952 630 L1010 600 L1060 706
           L1060 820 Z"
        fill="url(#ha-peak)"
      />
      {/* Sunlit western flank — a pale wash down the left face so the mass has
          a light side and does not read as a flat silhouette. */}
      <path
        d="M532 154 L474 286 L506 314 L412 476 L370 452 L292 602 L236 574
           L128 730 L560 820 L580 420 Z"
        fill="#faf7f1"
        opacity="0.3"
        filter="url(#ha-softer)"
      />
      {/* Ink washes on the shaded flank — where a brush would pool. */}
      <g filter="url(#ha-mist)" opacity="0.5">
        <ellipse cx="660" cy="420" rx="120" ry="150" fill="#1b1915" />
        <ellipse cx="560" cy="300" rx="70" ry="130" fill="#1b1915" />
      </g>
    </g>

    {/* Mist bands cutting the mountain base. These come BEFORE the ribbon: when
        they were painted over it, they bleached the silk to pink on the left
        half — in the boards the ribbon is the one saturated thing on the page. */}
    <g filter="url(#ha-mist)">
      <ellipse cx="400" cy="612" rx="470" ry="52" fill="#f5f2ec" opacity="0.95" />
      <ellipse cx="720" cy="690" rx="400" ry="44" fill="#f5f2ec" opacity="0.9" />
      <ellipse cx="200" cy="716" rx="360" ry="38" fill="#f5f2ec" opacity="0.9" />
      <ellipse cx="560" cy="486" rx="300" ry="22" fill="#f5f2ec" opacity="0.5" />
    </g>

    {/* The red silk ribbon. A closed shape rather than a stroke, so its width
        varies like fabric: it enters bottom-left, sweeps across the base of the
        peak, folds back on itself mid-frame and lifts away up the right flank. */}
    <g>
      <path
        d="M16 792 C 190 754 256 612 452 646 C 620 674 716 616 918 456"
        fill="none"
        stroke="#a02a20"
        stroke-width="88"
        stroke-linecap="round"
        opacity="0.14"
        filter="url(#ha-glow)"
      />
      {/* Main sweep — wide through the middle, tapering at both ends. */}
      <path
        d="M8 800
           C 186 754 250 596 452 630
           C 626 660 722 600 930 442
           C 914 500 842 556 726 618
           C 600 686 476 716 416 700
           C 296 668 190 756 36 816
           Z"
        fill="url(#ha-silk)"
        opacity="0.95"
      />
      {/* The fold: a narrower band peeling off the main sweep, darker because it
          is the underside of the fabric. */}
      <path
        d="M452 630
           C 560 650 640 628 762 552
           C 700 646 588 692 470 690
           C 430 688 420 660 452 630
           Z"
        fill="#7e211a"
        opacity="0.75"
      />
      {/* Specular highlight along the upper edge. */}
      <path
        d="M40 786 C 206 744 268 600 456 632 C 626 662 724 604 922 448"
        fill="none"
        stroke="#e88b7b"
        stroke-width="4.5"
        stroke-linecap="round"
        opacity="0.6"
      />
    </g>

    {/* One thin veil back over the silk so it sits inside the mist rather than
        on top of it, then haze into the paper so the image has no bottom edge. */}
    <g filter="url(#ha-mist)" opacity="0.4">
      <ellipse cx="300" cy="726" rx="380" ry="34" fill="#f5f2ec" />
    </g>
    <rect x="0" y="580" width="1000" height="240" fill="url(#ha-haze)" />
  </svg>
</div>
