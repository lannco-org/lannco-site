---
import Seal from './Seal.astro';

const links = [
  { href: '/about/', label: 'About' },
  { href: '/capabilities/', label: 'Capabilities' },
  { href: '/sectors/', label: 'Sectors' },
  { href: '/journal/', label: 'Journal' },
  { href: '/contact/', label: 'Contact' },
];
// Not in the primary nav on the boards, but they are real pages — they live in
// the hamburger panel and the footer index.
const extraLinks = [
  { href: '/global-presence/', label: 'Global Presence' },
  { href: '/our-process/', label: 'Our Process' },
];
const { pathname } = Astro.url;
---
<div class="announce" data-announce>
  <p>
    LANNCO Journal: The Rise of Private Capital in the GCC
    <a href="/journal/">Read Now &rarr;</a>
  </p>
  <button class="announce-close" data-announce-close aria-label="Dismiss announcement">&#215;</button>
</div>
<header class="site-header">
  <div class="container nav">
    <a class="nav-brand" href="/">LANNCO <Seal class="seal-mark" /></a>
    <nav class="nav-links" aria-label="Primary">
      {links.map(({ href, label }) => (
        <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <div class="nav-end">
      <a class="nav-private" href="/private-circle/">Private Circle</a>
      {/* Present at every width — all three boards show it at desktop too. */}
      <button
        class="nav-toggle"
        data-nav-toggle
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Open menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
{/* Starts inert so it is out of the tab order before nav.ts runs. */}
<div class="nav-panel" id="nav-panel" data-nav-panel inert>
  <nav class="nav-panel-inner container" aria-label="All pages">
    {[...links, ...extraLinks, { href: '/private-circle/', label: 'Private Circle' }].map(({ href, label }) => (
      <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</div>
