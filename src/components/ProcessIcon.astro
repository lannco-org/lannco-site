---
/**
 * Asset #16 — the five Our Process step icons. Line icons only; the red circle
 * is CSS (.process-icon) so stroke weight stays independent of circle size.
 *
 * These are interpretations of the boards, not traces: the icons appear at
 * ~20px in Boards B and C, too small to read the actual line work. Worth a
 * look from Ryan/the client when the Our Process page is built.
 */
interface Props {
  name: 'discover' | 'evaluate' | 'connect' | 'execute' | 'build';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<span class:list={['process-icon', className]} aria-hidden="true">
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
  >
    {name === 'discover' && (
      <>
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="M15.5 15.5 21 21" />
      </>
    )}
    {name === 'evaluate' && (
      <>
        <path d="M12 3v16" />
        <path d="M5 7h14" />
        <path d="M5 7 2.5 13h5z" />
        <path d="M19 7l-2.5 6h5z" />
        <path d="M8 21h8" />
      </>
    )}
    {name === 'connect' && (
      <>
        <circle cx="6" cy="12" r="3.2" />
        <circle cx="18" cy="12" r="3.2" />
        <path d="M9.2 12h5.6" />
      </>
    )}
    {name === 'execute' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <circle cx="12" cy="12" r="3.6" />
        <path d="M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3" />
      </>
    )}
    {name === 'build' && (
      <>
        <path d="M3 21h18" />
        <path d="M6 21V10l6-4 6 4v11" />
        <path d="M10 21v-6h4v6" />
      </>
    )}
  </svg>
</span>
