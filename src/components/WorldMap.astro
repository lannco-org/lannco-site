---
/**
 * Asset #15 — dotted world map with the seven LANNCO locations and the
 * connection arcs between them.
 *
 * Generated, not hand-drawn: the 2290 land dots come from a 2.6-degree
 * grid tested against Natural Earth 110m land polygons (public domain).
 * Antarctica is cropped (-56..84 latitude), matching the boards.
 * Equirectangular projection. Regenerate rather than edit dots by hand.
 *
 * Arcs carry pathLength="1" so Phase 4 can draw them with stroke-dashoffset,
 * and the markers/arcs already have their data-anim hooks.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
