---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';

const aboutTimeline = [
  { year: '2024', place: 'Founding of LANNCO' },
  { year: '2019', place: 'South Africa' },
  { year: '2018', place: 'Middle East' },
  { year: '2015', place: 'Singapore' },
  { year: '2012', place: 'Europe' },
  { year: '2008', place: 'Hong Kong' },
  { year: '2005', place: 'Beijing' },
];
---
<Base
  title="About — LANNCO"
  description="An independent cross-border advisory and strategic introductions platform."
>
  <section class="about-reference" aria-labelledby="about-title">
    <img
      class="about-reference-art"
      src="/assets/about-reference-art.svg?v=4"
      width="1672"
      height="940"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="container about-reference-grid">
      <div class="about-reference-copy">
        <h1 id="about-title" class="display" data-anim="split-lines">About LANNCO</h1>
        <hr class="rule" data-anim="fade" />
        <div class="about-reference-intro">
          <p data-anim="rise">
            We are an independent cross-border advisory and strategic introduction platform,
            connecting capital, markets and people across Asia, the Middle East, Europe and Africa.
          </p>
          <p data-anim="rise">
            We operate with discretion, integrity, and a deep understanding of cultures,
            markets and relationships.
          </p>
        </div>
        <a class="cta" href="/contact/" data-anim="rise">
          Our Story <Arrow class="cta-arrow" />
        </a>
      </div>

      <div class="about-reference-history">
        <ol class="about-timeline" data-anim-stagger aria-label="LANNCO timeline">
          {aboutTimeline.map(({ year, place }) => (
            <li>
              <time class="about-timeline-year" datetime={year}>{year}</time>
              <span class="about-timeline-place">{place}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>
