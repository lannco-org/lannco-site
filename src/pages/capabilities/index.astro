---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Arrow from '../../components/Arrow.astro';
import Art from '../../components/Art.astro';
import { capabilities } from '../../data/capabilities';

// Card anatomy follows Board C — image on top, title/blurb/arrow below — with
// the staggered vertical offsets from Board B. The home page keeps the
// text-over-image treatment from Board A, which is intentional.
---
<Base
  title="Capabilities — LANNCO"
  description="Strategic advisory, private introductions, institutional markets and curated opportunities."
>
  <section class="section">
    <div class="container">
      <SectionHead
        heading="Our Capabilities"
        level="h1"
        intro="We operate with discretion, integrity, and a deep understanding of cultures, markets, and relationships."
        introSecondary="Each capability is designed to create meaningful opportunities and lasting impact."
        ctaLabel="Explore Capabilities"
        ctaHref="/capabilities/strategic-advisory/"
      />
      <div class="cap-list" data-anim-stagger>
        {capabilities.map(({ slug, num, title, blurb, texture, asset }) => (
          <a class="cap-item" href={`/capabilities/${slug}/`}>
            <div class="cap-item-media">
              <Art
                asset={asset}
                variant={texture}
                ratio="3 / 4"
                sizes="(max-width: 36rem) 100vw, (max-width: 64rem) 50vw, 25vw"
              />
            </div>
            <span class="cap-item-num label">{num}</span>
            <h2 class="display">{title}</h2>
            <p>{blurb}</p>
            <Arrow class="cap-item-arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
