---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Seal from '../components/Seal.astro';
import Art from '../components/Art.astro';

// Heading uses Board C's "Relationships Begin with Conversations" (COPY.md v2).
// Still a mailto, not a form — Phase 6 wires Resend/Formspree, which needs the
// real contact address confirmed first (COPY.md open question 5).
---
<Base
  title="Contact — LANNCO"
  description="We work through referrals and selected introductions."
>
  <section class="section">
    <div class="container lead">
      <div class="lead-copy">
        <h1 class="display" data-anim="split-lines">Relationships Begin<br />with Conversations.</h1>
        <hr class="rule" data-anim="fade" />
        <p data-anim="rise">We work through referrals and selected introductions.</p>
        <a class="cta" href="mailto:hello@lannco.com" data-anim="rise">
          Start a Conversation <Arrow class="cta-arrow" />
        </a>
      </div>
      <div class="lead-visual">
        <Art
          asset="#4 dark cave/stone interior opening onto red maple"
          variant="dark"
          ratio="4 / 3"
          sizes="(max-width: 56rem) 100vw, 50vw"
        />
        <Seal class="visual-seal" />
      </div>
    </div>
  </section>
</Base>
