---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Art from '../components/Art.astro';
import WorldMap from '../components/WorldMap.astro';
import { stats, locations } from '../data/site';

const capabilities = [
  {
    num: '01',
    title: 'Strategic Advisory',
    texture: 'stone',
    asset: '#6 rough grey stone monolith on ivory',
    blurb: 'Providing clarity and strategy for cross-border expansion, market entry, and capital strategy.',
  },
  {
    num: '02',
    title: 'Private Introductions',
    texture: 'silk',
    asset: '#7 red silk/velvet fabric folds, macro',
    blurb: 'Creating trusted introductions between investors, founders, family offices and strategic partners.',
  },
  {
    num: '03',
    title: 'Institutional Markets',
    texture: 'ink',
    asset: '#8 black liquid-marble/ink swirl',
    blurb: 'Access to institutional networks in commodities, energy, and digital assets.',
  },
  {
    num: '04',
    title: 'Opportunities',
    texture: 'marble',
    asset: '#9 white marble geometric block',
    blurb: 'Curated access to private markets, real estate, and luxury alternative assets.',
  },
] as const;
const regions = ['Asia', 'Middle East', 'Europe', 'Africa'];
---
<Base preloader>
  {/* data-intro: everything in here plays as one choreographed load-in behind
      the preloader instead of firing on scroll. Order follows the DOM. */}
  <section class="hero" data-intro data-hero-cinema>
    {/* Full-bleed hero art (ASSETS.md #1). It sits outside `.container` on
        purpose — the image spans the whole viewport and the copy overlays its
        empty side, which is how Board C frames it. It used to live inside the
        grid's right-hand column; that confined it to ~58vw and, at mobile
        widths, made it compete with the copy for vertical space (see the
        56rem block in global.css). Behind the copy instead, it can't be
        squeezed. */}
    <div class="hero-stage">
      <div class="hero-media" data-anim="mask-up">
        <img
          src="/assets/lannco-hero-reference-v2.svg"
          width="1536"
          height="1024"
          alt="A monochrome mountain rising through mist, crossed by a flowing red ribbon beside the Chinese 岚 symbol"
          class="hero-photo hero-photo--reference"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <svg
          class="hero-ribbon-motion"
          viewBox="0 0 1536 1024"
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <path class="ribbon-current ribbon-current-a" pathLength="1" d="M 205 824 C 340 795 432 735 512 662 C 615 568 730 595 820 575 C 900 558 953 523 1015 472" />
          <path class="ribbon-current ribbon-current-b" pathLength="1" d="M 224 792 C 365 773 451 705 530 636 C 626 551 738 577 826 558 C 910 540 958 509 1018 461" />
          <path class="ribbon-current ribbon-current-c" pathLength="1" d="M 259 846 C 390 809 470 748 546 680 C 633 602 735 613 825 589 C 904 568 959 531 1008 493" />
        </svg>
        <span class="hero-atmosphere" aria-hidden="true"></span>
      </div>
      <div class="container">
        <div class="hero-grid">
        <div class="hero-copy">
          {/* Breaks are explicit: every mockup shows four lines, desktop and
              mobile, so line count shouldn't drift with the column width. */}
          <h1 class="display" data-anim="split-lines">
            Connecting<br />Capital.<br />Markets.<br /><span class="accent">People.</span>
          </h1>
          <hr class="rule" data-anim="fade" />
          <p class="hero-sub" data-anim="rise">
            An independent advisory and strategic introductions platform, connecting capital,
            markets, and people across Asia, the Middle East, Europe and Africa.
          </p>
          <a class="cta" href="/about/" data-anim="rise">
            Discover LANNCO <Arrow class="cta-arrow" />
          </a>
        </div>
        {/* Now holds only the watermark and seal — the art moved out to the
            full-bleed layer above. Kept as a grid cell because both are
            positioned against it, and because it reserves the right-hand column
            so the region strip below still lines up under the peak. */}
        <div class="hero-visual" aria-hidden="true"></div>
        <ul class="hero-regions" data-anim-stagger>
          {regions.map((region) => <li>{region}</li>)}
        </ul>
        </div>
      </div>
      {/* Full-viewport WebGL2 fog, which is what the reference site runs behind
        its hero. Purely additive over the image — if WebGL2 is missing or motion
        is reduced, motion.ts removes it and the still image stands alone. */}
      <canvas class="hero-mist" data-mist aria-hidden="true"></canvas>

    {/* Board C's mobile hero ends on a SCROLL cue; the reference site keeps the
        same label at desktop, bottom-left. */}
      <span class="scroll-cue label" data-anim="fade" aria-hidden="true">Scroll</span>
      <span class="hero-progress" aria-hidden="true"><span></span></span>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="display" data-anim="split-lines">Our Capabilities</h2>
          <hr class="rule" data-anim="fade" />
        </div>
        <div>
          <p class="section-intro" data-anim="char-fade">
            We operate with discretion, integrity, and a deep understanding of cultures, markets,
            and relationships.
          </p>
          <a class="cta" href="/capabilities/" data-anim="rise" style="margin-top: 1.2rem;">
            View All Capabilities <Arrow class="cta-arrow" />
          </a>
        </div>
      </div>
      <div class="card-grid" data-anim-stagger>
        {capabilities.map(({ num, title, texture, asset, blurb }) => (
          <a class="cap-card" href="/capabilities/" data-texture={texture} aria-label={`${title} — ${blurb}`}>
            <div class="card-media">
              <Art
                asset={asset}
                variant={texture}
                ratio="3 / 4"
                sizes="(max-width: 36rem) 100vw, (max-width: 64rem) 50vw, 25vw"
              />
            </div>
            <h3>{title}</h3>
            <span class="card-num">{num}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Condensed Global Presence — Board C's mobile home scrolls hero →
      capabilities → global presence. The full treatment is /global-presence/. */}
  <section class="section">
    <div class="container lead">
      <div class="lead-copy">
        <h2 class="display" data-anim="split-lines">Global Presence</h2>
        <hr class="rule" data-anim="fade" />
        <p data-anim="char-fade">
          A global network built on trust, relationships, and cultural intelligence.
        </p>
        <ul class="location-list" data-anim-stagger>
          {locations.slice(0, 4).map((place) => <li>{place}</li>)}
        </ul>
        <a class="cta" href="/global-presence/" data-anim="rise">
          View Our Network <Arrow class="cta-arrow" />
        </a>
      </div>
      <div class="lead-visual">
        <WorldMap />
      </div>
    </div>
    <div class="container stat-row stat-row-compact" data-anim-stagger>
      {stats.slice(0, 2).map(({ value, label }) => (
        <div class="stat">
          <span class="stat-value display" data-anim="count">{value}</span>
          <span class="stat-label label">{label}</span>
        </div>
      ))}
    </div>
  </section>
</Base>
