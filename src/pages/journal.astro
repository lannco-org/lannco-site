---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Placeholder from '../components/Placeholder.astro';
import { articles } from '../data/site';

// Board C: one large featured card plus a row of smaller ones, then the "All
// Articles" list view its mobile board shows.
//
// Cards do not link anywhere yet — article bodies are still outstanding
// (docs/COPY.md open question 2) and Phase 3 turns this into a content
// collection with real routes.
const featured = articles.find((a) => a.featured)!;
const rest = articles.filter((a) => !a.featured);
---
<Base
  title="Journal — LANNCO"
  description="Perspectives on capital, markets, and the future of global opportunity."
>
  <section class="section">
    <div class="container">
      <SectionHead
        heading="Insights<br />Beyond Borders"
        level="h1"
        intro="Perspectives on capital, markets, and the future of global opportunity."
      />

      <article class="journal-featured" data-anim="rise">
        <div class="journal-featured-media">
          <Placeholder asset={featured.asset} variant="dark" ratio="16 / 9" />
        </div>
        <div class="journal-featured-body">
          <span class="journal-cat label">{featured.category}</span>
          <h2 class="display">{featured.title}</h2>
          <span class="journal-date">{featured.date}</span>
        </div>
      </article>

      <div class="journal-grid" data-anim-stagger>
        {rest.map(({ title, category, date, asset }) => (
          <article class="journal-card">
            <Placeholder asset={asset} variant="dark" ratio="4 / 3" />
            <span class="journal-cat label">{category}</span>
            <h3>{title}</h3>
            <span class="journal-date">{date}</span>
          </article>
        ))}
      </div>

      {/* Board C's mobile board also shows an "All Articles" list view. Not
          rendered here: with only five articles it would repeat the featured
          card and the four cards above it verbatim on one screen. Phase 3 gives
          articles real routes, at which point it becomes its own page. */}
    </div>
  </section>
</Base>
