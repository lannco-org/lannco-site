---
import Base from '../../layouts/Base.astro';
import { getIndex, articleHref } from '../../data/journal';

const { featured, rest } = await getIndex();
const articles = [featured, ...rest].slice(0, 4);
const journalCards = [
  {
    category: 'Markets',
    title: 'Commodities Cycle: Positioning for the Next Decade',
    date: 'May 12, 2024',
    datetime: '2024-05-12',
    art: '/assets/journal-markets-hires.svg',
  },
  {
    category: 'Geopolitics',
    title: 'The New Geography of Power and Capital',
    date: 'April 28, 2024',
    datetime: '2024-04-28',
    art: '/assets/journal-geopolitics-hires.svg',
  },
  {
    category: 'Lifestyle',
    title: 'Intentional Living: Freedom by Design',
    date: 'April 10, 2024',
    datetime: '2024-04-10',
    art: '/assets/journal-lifestyle-hires.svg',
  },
  {
    category: 'Insights',
    title: 'Beyond Assets: Building Lasting Legacies',
    date: 'March 25, 2024',
    datetime: '2024-03-25',
    art: '/assets/journal-insights-hires.svg',
  },
].map((card, index) => ({
  ...card,
  href: articleHref(articles[index]),
}));
---
<Base
  title="Journal — LANNCO"
  description="Thoughts on markets, capital, geopolitics, lifestyle and the intersections that shape tomorrow."
>
  <section class="journal-reference">
    <div class="container">
      <header class="journal-reference-head">
        <div class="journal-reference-title">
          <h1 class="display" data-anim="split-lines">Our Journal</h1>
          <hr class="rule" data-anim="fade" />
          <p class="journal-reference-kicker">Insights. Perspectives. Opportunities.</p>
        </div>
        <p class="journal-reference-intro" data-anim="rise">
          Thoughts on markets, capital, geopolitics, lifestyle and the intersections
          that shape tomorrow.
        </p>
      </header>

      <div class="journal-reference-grid">
        {journalCards.map((card, index) => (
          <a class="journal-reference-card" href={card.href}>
            <span class="journal-reference-media">
              <img
                src={card.art}
                width="1536"
                height="1024"
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </span>
            <span class="journal-reference-body">
              <span class="journal-reference-category">{card.category}</span>
              <h2 class="display">{card.title}</h2>
              <span class="journal-reference-meta">
                <time datetime={card.datetime}>{card.date}</time>
                <span class="journal-reference-arrow" aria-hidden="true">→</span>
              </span>
            </span>
          </a>
        ))}
      </div>

      <footer class="journal-reference-footer">
        <a class="cta" href="/journal/all/">
          View All Articles <span class="journal-reference-footer-arrow" aria-hidden="true">→</span>
        </a>
        <span class="journal-reference-footer-line" aria-hidden="true"></span>
        <span class="journal-reference-dots" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
      </footer>
    </div>
  </section>
</Base>
