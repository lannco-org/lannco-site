---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Art from '../components/Art.astro';
---
<Base
  title="Private Circle — LANNCO"
  description="Our Private Circle is reserved for clients and partners by invitation only."
>
  <section class="section">
    <div class="container lead">
      <div class="lead-copy">
        <h1 class="display" data-anim="split-lines">Access by Invitation</h1>
        <hr class="rule" data-anim="fade" />
        <p data-anim="rise">
          Our Private Circle is reserved for clients and partners by invitation only.
          Contact us directly to request consideration for membership.
        </p>
        <div class="contact-actions" data-anim="rise">
          <a
            class="cta"
            href="mailto:sasha.zhou@lann-co.com?subject=LANNCO%20Private%20Circle%20Access%20Request&amp;body=Hello%20Sasha%2C%20I%20would%20like%20to%20request%20access%20to%20the%20LANNCO%20Private%20Circle."
          >
            Request by Email <Arrow class="cta-arrow" />
          </a>
          <a
            class="cta"
            href="https://wa.me/6596576728?text=Hello%20Sasha%2C%20I%20would%20like%20to%20request%20access%20to%20the%20LANNCO%20Private%20Circle."
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Request LANNCO Private Circle access on WhatsApp"
          >
            Request on WhatsApp <Arrow class="cta-arrow" />
          </a>
        </div>
      </div>
      <div class="lead-visual">
        <Art
          asset="#5 red maple branch against dark interior wall + shoji light"
          variant="dark"
          ratio="4 / 3"
          sizes="(max-width: 56rem) 100vw, 50vw"
        />
      </div>
    </div>
    <div class="container">
      <p class="circle-tagline label" data-anim="rise">Discreet. Selective. Exclusive.</p>
    </div>
  </section>
</Base>
