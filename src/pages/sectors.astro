---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Art from '../components/Art.astro';
import { sectors } from '../data/site';

// Board C's 2x4 grid, not Board B's single row of 8 (docs/HANDOFF.md).
---
<Base
  title="Sectors — LANNCO"
  description="Deep expertise across industries and asset classes."
>
  <section class="section">
    <div class="container">
      <SectionHead
        heading="Sectors We Serve"
        level="h1"
        intro="Deep expertise across industries and asset classes."
        ctaLabel="Explore Sectors"
        ctaHref="/contact/"
      />
      <ul class="sector-grid" data-anim-stagger>
        {sectors.map(({ label, asset }) => (
          <li class="sector-tile">
            <Art asset={asset} variant="ivory" ratio="1 / 1" sizes="(max-width: 56rem) 50vw, 25vw" />
            <span class="sector-label">{label}</span>
          </li>
        ))}
      </ul>
      <p class="sector-tagline display" data-anim="rise">
        Selected. Discreet. <span class="accent">Impactful.</span>
      </p>
    </div>
  </section>
</Base>
